# Proveedor LLM primario:
# - openai  → API key + GEMINI_BASE_URL (AI Studio, Mac/Qwen, etc.)
# - vertex  → Vertex AI (ADC / SA de Cloud Run; sin GEMINI_API_KEY)
LLM_PROVIDER=openai

# --- Modo openai (local / AI Studio / gateway OpenAI-compatible) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=90

# --- Modo vertex (Cloud Run en GCP) ---
# LLM_PROVIDER=vertex
# GCP_PROJECT_ID=marine-alchemy-510716-j5
# VERTEX_LOCATION=us-east4
# GEMINI_MODEL=google/gemini-2.5-flash
# GEMINI_TIMEOUT=110
# Opcional: override del endpoint OpenAI-compatible de Vertex
# GEMINI_BASE_URL=https://us-east4-aiplatform.googleapis.com/v1/projects/marine-alchemy-510716-j5/locations/us-east4/endpoints/openapi
# No hace falta GEMINI_API_KEY: usa Application Default Credentials (SA).

# Conocimiento (cuestionarios + basamento): local (repo) o GCS
# KNOWLEDGE_SOURCE=local
# KNOWLEDGE_SOURCE=gcs
# GCS_BUCKET_CUESTIONARIOS=compliance-cuestionarios-26265028623
# GCS_BUCKET_BASAMENTO=compliance-basamento-legal-26265028623

# Fallback — servidor OpenAI-compatible (si el primario falla 429/404/503/524 timeout)
FALLBACK_ENABLED=false
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_TIMEOUT=180

# Seguridad / red
# Orígenes del front permitidos (coma-separados). Usar * solo en demos locales.
# Con gateways (Laravel/Nest) el navegador no debería llamar a FastAPI:
# deja vacío o solo orígenes internos cuando ya no haya consumo directo.
# Incluir el origen del sandbox local (mismo host de uvicorn).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
# Tamaño máximo de archivo subido (MB)
MAX_UPLOAD_MB=25

# Auth gateway multi-cliente (servicio-a-servicio). Header: X-Agent-Key
# false = demos locales sin gateway (default si omites la variable).
# true en staging/prod.
AGENT_AUTH_ENABLED=true
# Clave del portal Laravel (pruebas). Debe coincidir con agents.secret_key del portal.
AGENT_CLIENT_LARAVEL_KEY=portal-local-dev-laravel-key-2026
# Clave del gateway Nest (producción).
AGENT_CLIENT_NEST_KEY=
# Swagger/ReDoc. false en staging/prod.
DOCS_ENABLED=true
